# Secrets / env
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.ruff_cache/
.pytest_cache/
*.ipynb_checkpoints/
.claude/

# Databases (large / regenerable)
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/predictions.db
data/questions/
data/cache/

# Logs (incl. metaculus debug JSON dumps)
logs/*.log
logs/*.json

# Model artifacts (large binaries; keep model/results/ JSON+CSV for history)
model/artifacts/*.pkl

# Learning-script outputs (regenerated by learning/sklearn/*.py)
loan_approval_model.pkl
roc_curve.png

# BIST brief outputs (regenerated on every report.py run; keep the source)
bist_brief/bist_data.csv
bist_brief/bist_panel.html
bist_brief/email*.html
bist_brief/email*.txt
bist_brief/meta.json
bist_brief/*.log

# Monitoring runtime state
monitoring/heartbeat_state.json

# Lock files
logs/*.lock

# Globally-installed tool with its own git repo (not project code)
context-hub/

# Credential files must never live in the repo
.cdsapirc

# Operator scratch/junk kept outside version control (untracked as of the
# 2026-09-28 docs rewrite; adding these patterns does not remove anything
# already committed)
logs/
.agents/
*.zip
bist_brief/preopen_*
bist_brief/news_*
bist_brief/inject_news*
