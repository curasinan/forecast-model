# Copy this to .env and fill in your API keys

# Anthropic (Claude) - Required for LLM predictor
ANTHROPIC_API_KEY=sk-ant-...

# NewsAPI.org - Optional, for Phase 2+ (free tier: 100 req/day)
NEWSAPI_KEY=

# GitHub - Optional, for GitHub activity collector (generous free tier)
GITHUB_TOKEN=

# Model settings
CLAUDE_MODEL=claude-sonnet-4-5-20250514

# Polymarket settings
POLYMARKET_API_BASE=https://clob.polymarket.com

# Database
DATABASE_PATH=data/predictions.db

# Weather / Open-Meteo (required for trading collectors — free host is non-commercial)
# OPEN_METEO_API_KEY=          # customer API key → customer-api.open-meteo.com
# OPEN_METEO_BASE_URL=         # or self-hosted Open-Meteo base URL
# OPEN_METEO_ALLOW_NONCOMMERCIAL=false
# WEATHER_DATA_ROOT=           # default: %LOCALAPPDATA%/polymarket_weather (keep off OneDrive)
# WEATHER_MIN_LIQUIDITY=1000
# WEATHER_MIN_VOLUME=5000

