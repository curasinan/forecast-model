# Copy to .env and fill in. Every key is explained in README.md, "Configuration".

# Legacy Polymarket-era LLM predictor and scorer
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250514
# LLM_PROMPTS_DIR=

# Optional evidence collectors
NEWSAPI_KEY=
GITHUB_TOKEN=

# Polymarket research track (retired runtime)
POLYMARKET_API_BASE=https://clob.polymarket.com
DATABASE_PATH=data/predictions.db

# Weather track (Open-Meteo)
# OPEN_METEO_API_KEY=
# OPEN_METEO_BASE_URL=
# OPEN_METEO_ALLOW_NONCOMMERCIAL=false
# WEATHER_DATA_ROOT=
# WEATHER_MIN_LIQUIDITY=1000
# WEATHER_MIN_VOLUME=5000

# Climate lane
# CLIMATE_DATA_ROOT=

# IBKR ForecastEx venue adapter; IBKR_PORT and IBKR_TRADING_MODE are required
# IBKR_HOST=127.0.0.1
# IBKR_PORT=
# IBKR_TRADING_MODE=
# IBKR_DATA_ROOT=
# IBKR_COMMISSION_PER_CONTRACT=
# IBKR_FEES_VERIFIED_ON=
# IBKR_COUPON_APY=
# IBKR_COUPON_VERIFIED_ON=
# IBKR_MAX_DATA_LINES=100
# IBKR_RECORD_INTERVAL_MINUTES=10
# IBKR_MARKET_DATA_TYPE=4
# IBKR_RESTART_WINDOW_LOCAL=

# Local LLM (OpenAI-compatible server)
# LLM_MODEL=
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MAX_TOKENS=8192
# LLM_REASONING_EFFORT=low
# LLM_TEMPERATURE=
# LLM_CONNECT_TIMEOUT_S=10
# LLM_READ_TIMEOUT_S=900
