# Copy this to .env and fill in your API keys

# Anthropic (Claude) - Required for LLM predictor
ANTHROPIC_API_KEY=sk-ant-...

# NewsAPI.org - Optional, for Phase 2+ (free tier: 100 req/day)
NEWSAPI_KEY=

# GitHub - Optional, for GitHub activity collector (generous free tier)
GITHUB_TOKEN=

# Model settings
CLAUDE_MODEL=claude-sonnet-4-5-20250514

# Polymarket settings
POLYMARKET_API_BASE=https://clob.polymarket.com

# Database
DATABASE_PATH=data/predictions.db

# Weather / Open-Meteo (required for trading collectors — free host is non-commercial)
# OPEN_METEO_API_KEY=          # customer API key → customer-api.open-meteo.com
# OPEN_METEO_BASE_URL=         # or self-hosted Open-Meteo base URL
# OPEN_METEO_ALLOW_NONCOMMERCIAL=false
# WEATHER_DATA_ROOT=           # default: %LOCALAPPDATA%/polymarket_weather (keep off OneDrive)
# WEATHER_MIN_LIQUIDITY=1000
# WEATHER_MIN_VOLUME=5000

# IBKR / ForecastEx venue adapter (src/venues/ibkr)
# IBKR_PORT and IBKR_TRADING_MODE have NO defaults BY DESIGN (migration spec
# Stage 7 loud-failure rule): a process must state which Gateway and which
# mode it expects or fail at startup with a ValidationError.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=                       # REQUIRED. Gateway: 4001 live / 4002 paper; TWS: 7496 / 7497
# IBKR_TRADING_MODE=               # REQUIRED. paper|live; checked against the account prefix on connect
# IBKR_DATA_ROOT=                  # default: %LOCALAPPDATA%/ibkr_ticks (keep OFF OneDrive: sync corrupts high-churn files)
# IBKR_COMMISSION_PER_CONTRACT=    # e.g. 0.01 -- set ONLY from a whatIf probe (docs/venue_semantics.md)
# IBKR_FEES_VERIFIED_ON=           # ISO date of that probe (e.g. 2026-08-16); fee_model() refuses without both
# IBKR_COUPON_APY=                 # e.g. 0.0314 -- verify from statements/accrual observation, never hardcode
# IBKR_COUPON_VERIFIED_ON=         # ISO date the coupon APY was verified; carry is NullCarry without both
# IBKR_MAX_DATA_LINES=100          # cap on concurrent market-data lines
# IBKR_RECORD_INTERVAL_MINUTES=10  # recorder snapshot cadence
# IBKR_MARKET_DATA_TYPE=4          # 4 = delayed-frozen; works with no paid data subscription

